{
  "name": "yange",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@ybouane/liquidglass": "^1.0.3",
    "onnxruntime-web": "1.29.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "dev": "npm run dev --workspace @yange/web",
    "dev:api": "npm run dev --workspace @yange/api",
    "dev:cloud": "node scripts/dev-cloud.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
